---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="fx grid" aria-hidden="true"></div>
    <div class="fx scanline" aria-hidden="true"></div>

    <div class="page">
      <slot />
      <footer>
        <a href={`${base}/`}>Start</a>
        <a href={`${base}/legal/#impressum`}>Impressum</a>
        <a href={`${base}/legal/#datenschutz`}>Datenschutz</a>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('../fonts/jetbrains-mono-latin.woff2') format('woff2');
  }
  :root {
    --bg: #0d0d0d;
    --surface: #141414;
    --surface-2: #101010;
    --border: #2a2a2a;
    --border-2: #333333;
    --text: #d8d8d8;
    --text-strong: #f0f0f0;
    --text-soft: #c4c4c4;
    --muted: #949494;
    --tag: #adadad;
    --accent: #5fe39a;
    --accent-light: #b6f5d1;
    color-scheme: dark;
  }
  html { background: var(--bg); }
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    overflow-x: hidden;
  }
  a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 4px; }
  a:hover { color: var(--accent-light); }

  .grid {
    position: fixed; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, .04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .04) 1px, transparent 1px);
    background-size: 48px 48px;
    animation: drift 14s linear infinite;
    -webkit-mask: radial-gradient(ellipse at 50% 30%, #000 20%, transparent 80%);
    mask: radial-gradient(ellipse at 50% 30%, #000 20%, transparent 80%);
  }
  .scanline {
    position: fixed; left: 0; right: 0; top: 0; height: 140px; pointer-events: none;
    background: linear-gradient(transparent, rgba(255, 255, 255, .025), transparent);
    animation: scan 11s linear infinite;
  }
  .cursor {
    display: inline-block; width: .45em; height: .08em; margin-left: .12em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes drift { to { background-position: 0 48px, 48px 0; } }
  @keyframes scan { from { transform: translateY(-100%); } to { transform: translateY(100vh); } }
  @keyframes blink { 50%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .fx { animation: none !important; } }

  .page {
    position: relative;
    max-width: 1040px;
    margin: 0 auto;
    padding: clamp(24px, 6vw, 80px) clamp(16px, 4vw, 40px) 32px;
    display: flex; flex-direction: column; gap: clamp(56px, 9vw, 96px);
  }
  .prompt { font-size: 13px; color: var(--muted); }
  .prompt span { color: var(--accent); }
  h1 {
    margin: 0;
    font: 700 clamp(36px, 8vw, 84px)/1 'JetBrains Mono', monospace;
    letter-spacing: -.05em;
    color: var(--text-strong);
  }

  footer { display: flex; gap: 24px; font-size: 12px; padding-top: 20px; border-top: 1px solid var(--border); }
  footer a { color: var(--muted); }
  footer a:hover { color: var(--accent); }
</style>
